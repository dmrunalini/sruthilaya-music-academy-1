rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for everything not explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow each authenticated user to read their own profile, and allow teachers to read other users
    match /users/{userId} {
      // read: either the owner or any authenticated teacher can read
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        // check requester's role is teacher by reading their own profile
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
      );

      // write: only the owner may write their profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Example: allow authenticated users to read classes
    match /classes/{classId} {
      // any authenticated user can read classes
      allow read: if request.auth != null;

  // create: only an authenticated teacher may create a class, and the teacherId in the new document
  // must match the authenticated user's uid. This ensures only accounts with role == 'teacher'
  // (stored in users/{uid}) can create class documents for themselves.
  allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        && request.auth.uid == request.resource.data.teacherId;

      // update & delete: only the teacher who owns the class may change or delete it
      allow update, delete: if request.auth != null
                            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
                            && request.auth.uid == resource.data.teacherId;
    }

    // Materials: allow authenticated users to read materials; only teachers may create/update/delete
    match /materials/{materialId} {
      // any authenticated user can read materials
      allow read: if request.auth != null;

      // create: only a user who has role == 'teacher' in users/{uid} and whose uid matches ownerUid
      allow create: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
                    && request.auth.uid == request.resource.data.ownerUid;

      // update & delete: only the owning teacher may change or delete the material
      allow update, delete: if request.auth != null
                            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
                            && request.auth.uid == resource.data.ownerUid;
    }

    // Add additional collection rules below as needed
  }
}
